{
  "name": "mdpro4-sacred-book",
  "private": true,
  "type": "module",
  "scripts": {
    "reference:generate": "python Tools/FunctionDocs/generate_function_docs.py",
    "reference:test": "python -m unittest Tools.FunctionDocs.test_rush_function_docs",
    "site:generate": "python Tools/Site/generate_site.py",
    "site:test": "python -m unittest Tools.Site.test_generate_site Tools.Site.test_card_catalog",
    "links:check": "python Tools/Site/validate_markdown_links.py",
    "docs:generate": "npm run reference:generate && npm run site:generate",
    "docs:dev": "npm run docs:generate && vitepress dev docs",
    "docs:build": "npm run docs:generate && vitepress build docs",
    "site:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
